ANTHROPIC_API_KEY=
NM_WRITER_MODEL=anthropic:claude-sonnet-5-5
# Phase 3: voice critic model; blank = same as NM_WRITER_MODEL
NM_CRITIC_MODEL=
NM_FAST_MODEL=anthropic:claude-haiku-5-5
# Phase 4: lead editor model; blank = same as NM_WRITER_MODEL
NM_EDITOR_MODEL=
# series mode: per-source relevance filter for `issue --series`; blank = NM_FAST_MODEL
NM_RELEVANCE_MODEL=
# Phase 4: critique -> revise loops per issue (0 to 3)
NM_MAX_REVISIONS=1
NM_VOICE_DIR=voice
LOG_LEVEL=INFO
# Optional tracing
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
# Phase 2: ingest (no Anthropic key needed)
NM_GMAIL_LABEL=newsletter
# Only mail from these senders is read ('me' = your own Gmail account), comma-separated
NM_GMAIL_ALLOWED_SENDERS=me
NM_GMAIL_CLIENT_SECRETS=.secrets/gmail-client.json
NM_GMAIL_TOKEN=.secrets/gmail-token.json
NM_FETCH_TIMEOUT=20
NM_TRANSCRIPT_LANGUAGES=en
# Phase 5: weekly run (`weekly`, Managed Deep Agents)
# base64 of the token `newsletter-machine gmail-auth` writes (see README runbook); blank = token file
NM_GMAIL_TOKEN_B64=
# time zone for the issue date; keep in step with schedules/weekly_issue.py
NM_TIMEZONE=Asia/Kolkata
# hosted runner agent's model; blank = NM_FAST_MODEL
NM_RUNNER_MODEL=
# opt-in: also create an UNPUBLISHED Substack draft (never publishes)
NM_SUBSTACK_DRAFT=false
SUBSTACK_PUBLICATION_URL=
# cookie string from a signed-in browser (preferred), or email + password
SUBSTACK_COOKIES=
SUBSTACK_EMAIL=
SUBSTACK_PASSWORD=
# LangSmith workspace, only if your API key needs one for `mda deploy`
LANGSMITH_WORKSPACE_ID=
